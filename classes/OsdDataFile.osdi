# A regular file.
class OsdDataFile : OsdFileSystem
version 1.0
override osdModifyPopupMenu
method osdQueryMimeType() -> string
method osdQueryIsProgram() -> bool
# An executable's Program page (as program objects have; 0.4 step 6):
# where it runs, in a window or a terminal, the terminal kept after it ends.
property prog_cwd : text page Program label "Working directory (empty: its own folder)" show osdQueryIsProgram
property prog_type : choice "automatic,window,text mode (in a terminal)" = automatic page Program label "Program type" show osdQueryIsProgram
property prog_close : checkbox = 1 page Program label "Close window on exit (text mode)" show osdQueryIsProgram
classoverride osdclsQueryTitle
# The program its type opens with: mimeapps.list's default, shared with
# GNOME (object-properties-design.md 2.6); for all files of its type through
# Class... (type:MIME).
property open_with : choice page Association label "Opens with" backing mimeapps
# Its type (0.8; OS/2's .TYPE): shown with where it comes from; set on the
# file (user.mime_type, which other programs read too), or taken off.
method osdQueryTypeShown() -> string
method osdQueryTypeSet() -> string
method osdSetTypeSet(string value) -> bool
method osdQueryTypeChoices() -> string
property type_shown : info page Type label "Its type" get osdQueryTypeShown
property type_set : choice page Type label "Set its type" get osdQueryTypeSet set osdSetTypeSet options osdQueryTypeChoices
