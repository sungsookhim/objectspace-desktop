# The Trash Can (v0.2-design 4): the trash's files folder
# (~/.local/share/Trash/files, as the freedesktop.org Trash specification
# has it, GNOME's too), its items shown by their original names; Empty
# trash in its menu.
class WPTrashCan : WPFolder
version 1.0
override wpModifyPopupMenu
classoverride wpclsQueryTitle
data {
    char *full_icon;    /* its own icon when full (a PNG); NULL: WPS's */
}
override wpUnInitData
override wpSaveState
override wpRestoreProperties
property icon : icon page Icon label Empty get wpQueryIcon set wpSetIcon
property fullicon : icon page Icon label Full get wpQueryFullIcon set wpSetFullIcon
# Its icon when something is in it (Icon, WPObject's, is when empty):
# the path of a PNG, or "" for WPS's again.
method wpQueryFullIcon() -> string
method wpSetFullIcon(string path) -> bool
