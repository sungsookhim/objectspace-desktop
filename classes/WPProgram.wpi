# A program to start (a .desktop file in M5).
class WPProgram : WPAbstract
version 1.0
data {
    char *command;
}
override wpUnInitData
override wpSaveState
override wpRestoreProperties
method wpQueryCommand() -> string
method wpSetCommand(string command) -> bool
# An autostart entry (in Startup): whether it starts at login.
method wpSetStartAtLogin(bool on) -> bool
# The Program page (v0.3-design 8): its type (0 automatic: a desktop
# entry's Terminal key; 1 a window; 2 text mode, in a terminal), Close
# window on exit (text mode; on by default), and its working directory
# ("": home). Kept in WPS's state, not in the desktop entry.
method wpSetProgramType(int choice) -> bool
method wpSetCloseOnExit(bool on) -> bool
method wpSetWorkingDir(string dir) -> bool
method wpQueryProgramType() -> int
method wpQueryInStartup() -> bool
method wpQueryStartAtLogin() -> bool
property command : text page Program label Command get wpQueryCommand set wpSetCommand
property cwd : text page Program label "Working directory" set wpSetWorkingDir
property program_type : choice "automatic,window,text mode (in a terminal)" page Program label "Program type" get wpQueryProgramType set wpSetProgramType
property close_on_exit : checkbox = 1 page Program label "Close window on exit (text mode)" set wpSetCloseOnExit
property start_at_login : checkbox page Program label "Start at login" show wpQueryInStartup get wpQueryStartAtLogin set wpSetStartAtLogin
classoverride wpclsQueryTitle
# A program from a desktop entry: the types it opens (its Association page;
# the user's copy of the entry, object-properties-design.md 2.6).
property mime_types : text page Association label "Types it opens (MIME, separated by ;)" backing desktop:MimeType
