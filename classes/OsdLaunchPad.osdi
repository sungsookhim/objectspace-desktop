# The LaunchPad object (v0.2-design 10): the LaunchPad's settings, in
# System; the desktop applies them.
class OsdLaunchPad : OsdSetup
version 1.0
classoverride osdclsQueryTitle
# Its settings (stored as text in the OsdSetup state, as before).
property show_at_start : choice "automatic,yes,no" = "automatic" page "LaunchPad" label "Show at start" store OsdSetup text
property orientation : choice "horizontal,vertical" = "horizontal" page "LaunchPad" label "Orientation" store OsdSetup text
property drawer_side : choice "right,left" = "right" page "LaunchPad" label "Drawers (vertical)" store OsdSetup text
property small_icons : checkbox = "0" page "LaunchPad" label "Small icons" store OsdSetup text
property text : checkbox = "1" page "LaunchPad" label "Text on buttons" store OsdSetup text
property float_top : checkbox = "1" page "LaunchPad" label "Float on top" store OsdSetup text
property close_drawer : checkbox = "1" page "LaunchPad" label "Close drawer after open" store OsdSetup text
