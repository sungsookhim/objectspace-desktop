# A program to start (a .desktop file in M5).
class OsdProgram : OsdAbstract
version 1.0
data {
    char *command;
}
override osdUnInitData
override osdSaveState
override osdRestoreProperties
method osdQueryCommand() -> string
method osdSetCommand(string command) -> bool
# An autostart entry (in Startup): whether it starts at login.
method osdSetStartAtLogin(bool on) -> bool
# The Program page (v0.3-design 8): its type (0 automatic: a desktop
# entry's Terminal key; 1 a window; 2 text mode, in a terminal), Close
# window on exit (text mode; on by default), and its working directory
# ("": home). Kept in WPS's state, not in the desktop entry.
method osdSetProgramType(int choice) -> bool
method osdSetCloseOnExit(bool on) -> bool
method osdSetWorkingDir(string dir) -> bool
method osdQueryProgramType() -> int
method osdQueryInStartup() -> bool
method osdQueryStartAtLogin() -> bool
property command : text page Program label Command get osdQueryCommand set osdSetCommand
property cwd : text page Program label "Working directory" set osdSetWorkingDir
property program_type : choice "automatic,window,text mode (in a terminal)" page Program label "Program type" get osdQueryProgramType set osdSetProgramType
property close_on_exit : checkbox = 1 page Program label "Close window on exit (text mode)" set osdSetCloseOnExit
property start_at_login : checkbox page Program label "Start at login" show osdQueryInStartup get osdQueryStartAtLogin set osdSetStartAtLogin
classoverride osdclsQueryTitle
# A program from a desktop entry: the types it opens (its Association page;
# the user's copy of the entry, object-properties-design.md 2.6).
property mime_types : text page Association label "Types it opens (MIME, separated by ;)" backing desktop:MimeType
