# A directory.
class WPFolder : WPFileSystem
version 1.0
data {
    int sort_order;
    int local_objects;
}
override wpModifyPopupMenu
override wpSaveState
override wpRestoreProperties
method wpQuerySortOrder() -> int
method wpSetSortOrder(int order) -> bool
# WPS-only objects (shadows and others) made here are kept as .wpobj files
# in the folder, instead of centrally (decided 2026-11-18).
method wpQueryLocalObjects() -> bool
method wpSetLocalObjects(bool on) -> bool
# Icon positions, stored on the folder by the child's object ID (design:
# Persistence; per user in folders the user does not own).
method wpSetIconPos(object child, int x, int y) -> bool
method wpQueryIconPos(object child) -> string
# Lists the folder's contents; streaming and paging arrive in M4.
method wpPopulate() -> pending async
# The Background page (v0.3-design 3): a picture (a path), how it is shown
# (0 centred, 1 tiled, 2 scaled to fill, 3 scaled to fit, 4 stretched), a
# colour (#rrggbb, "" none), and for the desktop whether GNOME's
# background is shown instead (the default).
# The details view (v0.3-design 4): its sort (the listing's order; 0 none,
# 1 name, 2 type, 3 size, 4 last write), descending, and its columns
# (bits: 1 real name, 2 type, 4 size, 8 last write; the title always).
method wpSetSortKey(int choice) -> bool
method wpSetSortDesc(bool on) -> bool
method wpSetColumn(string which_on) -> bool
# its columns' widths as dragged: "w1,w2,..." (title .. last write; 0 as it fits)
method wpSetColWidths(string widths) -> bool
method wpSetBgImage(string path) -> bool
method wpSetBgMode(int mode) -> bool
method wpSetBgColor(string color) -> bool
method wpSetBgGnome(bool on) -> bool
override wpAddSettingsPages
classoverride wpclsQueryTitle
