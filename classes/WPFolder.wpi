# A directory.
class WPFolder : WPFileSystem
version 1.1
data {
    int sort_order;
    int local_objects;
}
override wpModifyPopupMenu
override wpSaveState
override wpRestoreProperties
method wpQuerySortOrder() -> int
method wpSetSortOrder(int order) -> bool
# WPS-only objects (shadows and others) made here are kept as .wpobj files
# in the folder, instead of centrally (decided 2026-11-18).
method wpQueryLocalObjects() -> bool
method wpSetLocalObjects(bool on) -> bool
# Icon positions, stored on the folder by the child's object ID (design:
# Persistence; per user in folders the user does not own).
method wpSetIconPos(object child, int x, int y) -> bool
method wpQueryIconPos(object child) -> string
# Lock position (v0.3-design 5): kept with the position, "x,y,L" ("L"
# alone: locked, no position stored yet). A locked icon stays where it is
# in its folder (it can still go to other folders) and Arrange leaves it.
method wpSetIconLock(object child, bool on) -> bool
method wpQueryIconLock(object child) -> bool
# The Icon view page: titles (0 whole, as OS/2's; 1 two lines), and Lock
# positions of all icons.
method wpSetIconTitles(int choice) -> bool
method wpSetLockAll(bool on) -> bool
# Its icons' title font (the Font Palette's, dropped on its window):
# "10.Sans", "" the System's for folders.
method wpSetIconFont(string font) -> bool
# Its window's title bar font (dropped on its title bar), "" all title bars'.
method wpSetTitleFont(string font) -> bool
# Lists the folder's contents; streaming and paging arrive in M4.
method wpPopulate() -> pending async
# The Background page (v0.3-design 3): a picture (a path), how it is shown
# (0 centred, 1 tiled, 2 scaled to fill, 3 scaled to fit, 4 stretched), a
# colour (#rrggbb, "" none), and for the desktop whether GNOME's
# background is shown instead (the default).
# The details view (v0.3-design 4): its sort (the listing's order; 0 none,
# 1 name, 2 type, 3 size, 4 last write), descending, and its columns
# (bits: 1 real name, 2 type, 4 size, 8 last write; the title always).
method wpSetSortKey(int choice) -> bool
method wpSetSortDesc(bool on) -> bool
method wpSetColumn(string which_on) -> bool
# its columns' widths as dragged: "w1,w2,..." (title .. last write; 0 as it fits)
method wpSetColWidths(string widths) -> bool
method wpSetBgImage(string path) -> bool
method wpSetBgMode(int mode) -> bool
method wpSetBgColor(string color) -> bool
method wpSetBgGnome(bool on) -> bool
# Its pages' properties (object-properties-design.md 2.1).
method wpQuerySortKey() -> int
method wpQueryIsDesktop() -> bool
method wpQueryColName() -> bool
method wpQueryColType() -> bool
method wpQueryColSize() -> bool
method wpQueryColDate() -> bool
method wpSetColName(bool on) -> bool
method wpSetColType(bool on) -> bool
method wpSetColSize(bool on) -> bool
method wpSetColDate(bool on) -> bool
property sort_key : choice "none,name,type,size,last write" page View label "Sort by" get wpQuerySortKey set wpSetSortKey
property sort_desc : checkbox page View label Descending set wpSetSortDesc
property local : checkbox page View label "Keep objects as files here" get wpQueryLocalObjects set wpSetLocalObjects
property show_hidden : checkbox = 1 page View label "Show hidden files (names starting with a dot)"
property show_ext : checkbox = 1 page View label "Show file extensions in titles"
property icon_titles : choice "whole,two lines" = whole index page "Icon view" label Titles set wpSetIconTitles
property lock_all : checkbox page "Icon view" label "Lock positions of all icons" set wpSetLockAll
property icon_font : text page "Icon view" label "Icon font (e.g. 10.Sans; empty: the System's)" set wpSetIconFont
property title_font : text page "Icon view" label "Title bar font (empty: all title bars')" set wpSetTitleFont
property col_name : checkbox page "Details view" label "Real name" get wpQueryColName set wpSetColName
property col_type : checkbox page "Details view" label Type get wpQueryColType set wpSetColType
property col_size : checkbox page "Details view" label Size get wpQueryColSize set wpSetColSize
property col_date : checkbox page "Details view" label "Last write" get wpQueryColDate set wpSetColDate
property col_widths : hidden page "Details view" label Widths set wpSetColWidths
property bg_gnome : checkbox = 1 page Background label "GNOME's background" show wpQueryIsDesktop set wpSetBgGnome
property bg_image : file image page Background label Image set wpSetBgImage
property bg_mode : choice "centred,tiled,scaled to fill,scaled to fit,stretched" = "scaled to fill" index page Background label Shown set wpSetBgMode
property bg_color : color page Background label Colour set wpSetBgColor
classoverride wpclsQueryTitle
