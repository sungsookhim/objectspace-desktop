# A scheme (OS/2's Scheme Palette's schemes; object-properties-design.md
# 2.3): the colours and sizes every Objectspace window is drawn with. Classic, Dark
# and High contrast are made in System Setup's Schemes folder; a copy of one
# (Create another) is a scheme of the user's. The Scheme Palette chooses.
# The defaults are Classic's (gui/ui_draw.c).
class OsdScheme : OsdAbstract
version 1.0
classoverride osdclsQueryTitle
property face : color = "#cccccc" page "Window" label "Face (buttons, frames)"
property light : color = "#ffffff" page "Window" label "3D light edge"
property shadow : color = "#808080" page "Window" label "3D shadow edge"
property dark : color = "#404040" page "Window" label "3D dark edge"
property text : color = "#000000" page "Window" label "Text"
property disabled_text : color = "#808080" page "Window" label "Disabled text"
property client_bg : color = "#ffffff" page "Window" label "Window background"
property alt_row : color = "#f2f2f7" page "Window" label "Alternate rows"
property selection : color = "#000080" page "Window" label "Selection"
property selection_text : color = "#ffffff" page "Window" label "Selected text"
property cursor : color = "#000000" page "Window" label "Text cursor"
property placeholder : color = "#e1e1e1" page "Window" label "Placeholder"
property shadow_text : color = "#005aaa" page "Window" label "Shadows' titles"
property title_active : color = "#000080" page "Title bars" label "Active title bar"
property title_inactive : color = "#969696" page "Title bars" label "Inactive title bar"
property title_text : color = "#ffffff" page "Title bars" label "Active title text"
property title_text_inactive : color = "#dcdcdc" page "Title bars" label "Inactive title text"
property menu_bg : color = "#cccccc" page "Menus" label "Menu"
property menu_text : color = "#000000" page "Menus" label "Menu text"
property menu_hilite : color = "#000080" page "Menus" label "Menu highlight"
property menu_hilite_text : color = "#ffffff" page "Menus" label "Menu highlight text"
property desktop : color = "#008080" page "Desktop" label "Desktop (no picture)"
property desktop_title : color = "#ffffff" page "Desktop" label "Icon titles on a picture"
property desktop_shadow_title : color = "#bfd9ff" page "Desktop" label "Shadows' titles on a picture"
property tooltip_bg : color = "#ffffe0" page "Desktop" label "Tooltip"
property tooltip_text : color = "#000000" page "Desktop" label "Tooltip text"
property urgent_bg : color = "#ffedd9" page "Desktop" label "Urgent notification"
property urgent_text : color = "#b30000" page "Desktop" label "Urgent text"
property font_px : number = "13" page "Sizes" label "Interface font size (pixels)" text
property border : number = "4" page "Sizes" label "Frame border" text
property title_h : number = "22" page "Sizes" label "Title bar height" text
property button_w : number = "18" page "Sizes" label "Title button width" text
property button_h : number = "16" page "Sizes" label "Title button height" text
# (0.4 step 7) TheBar's and the Launcher's own colours (empty: the
# face's and the text's), the meters'
property bar : color page "Bars" label "TheBar and Launcher (empty: the face)"
property bar_text : color page "Bars" label "Their text (empty: the text)"
property meter_cpu : color = "#33b34d" page "Bars" label "Processor meter"
property meter_memory : color = "#4073d9" page "Bars" label "Memory meter"
property meter_disk : color = "#d98c26" page "Bars" label "Disk meter"
property meter_network : color = "#9959cc" page "Bars" label "Network meter"
# (0.4 step 8) the Dialogs font: notebooks, dialogs, Find, the window list,
# the palettes (a font from the Font Palette dropped on one of them sets it)
property font_dialogs : text page "Fonts" label "Dialogs (e.g. 10.Sans; empty: the interface font)"
