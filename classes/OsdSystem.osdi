# The System object: windows' look, confirmations.
class OsdSystem : OsdSetup
version 1.0
classoverride osdclsQueryTitle
# Its settings (stored as text in the OsdSetup state, as before).
property corner_radius : choice "0,2,4,8,12,16" = "0" page "Window" label "Window corner radius" store OsdSetup text
property buttons : choice "always,on hover" = "always" page "Window" label "Title-bar buttons" store OsdSetup text
property border : choice "visible,thin,none" = "visible" page "Window" label "Frame border" store OsdSetup text
property shadows : choice "off,subtle,strong" = "off" page "Window" label "Window shadows" store OsdSetup text
property translucency : choice "off,title bars,menus" = "off" page "Window" label "Translucency" store OsdSetup text
property title_layout : choice "normal,mirrored,compact" = "normal" page "Window" label "Title-bar layout" store OsdSetup text
property x11_scale : checkbox = "1" page "Window" label "Scale X11 programs themselves (sharp on scaled screens)" store OsdSetup text
property confirm_delete : checkbox = "1" page "Confirmations" label "Confirm on delete" store OsdSetup text
property confirm_folder_delete : checkbox = "1" page "Confirmations" label "Confirm on folder delete" store OsdSetup text
property restore_windows : checkbox = "1" page "Login" label "Restore open windows at login" store OsdSetup text
# (all folders' settings: class:OsdFolder's, object-properties-design.md 2.2)
method osdQueryFoldersHidden() -> string
method osdSetFoldersHidden(string on) -> bool
method osdQueryFoldersExt() -> string
method osdSetFoldersExt(string on) -> bool
method osdQueryFoldersMenuBar() -> string
method osdSetFoldersMenuBar(string on) -> bool
method osdQueryFoldersTheme() -> string
method osdSetFoldersTheme(string theme) -> bool
method osdQueryIconThemes() -> string
property icon_theme : choice = "Objectspace (flat)" page "Theme" label "Icon theme" get osdQueryFoldersTheme set osdSetFoldersTheme options osdQueryIconThemes
method osdQueryFoldersIconSet() -> string
method osdSetFoldersIconSet(string set) -> bool
property icon_set : choice "Small,Default,Large" = "Default" page "Theme" label "Icon size (Small 32/16, Default 64/32/16, Large 96/48/24)" get osdQueryFoldersIconSet set osdSetFoldersIconSet
property hatch_open : checkbox = "0" page "Theme" label "Hatch open icons too (every object's)" store OsdSetup text
property cursors : choice "Objectspace,system" = "Objectspace" page "Theme" label "Pointers (Objectspace's, after OS/2's, or the system's)" store OsdSetup text
method osdQueryFoldersFont() -> string
method osdSetFoldersFont(string font) -> bool
property show_hidden : checkbox = "1" page "Folders" label "Show hidden files (names starting with a dot)" get osdQueryFoldersHidden set osdSetFoldersHidden
property show_ext : checkbox = "1" page "Folders" label "Show file extensions in titles" get osdQueryFoldersExt set osdSetFoldersExt
property menu_bar : checkbox = "0" page "Folders" label "Menu bar in folder windows" get osdQueryFoldersMenuBar set osdSetFoldersMenuBar
property font_folders : text = "" page "Fonts" label "Folders' icon titles (e.g. 10.Sans; empty: the interface font)" get osdQueryFoldersFont set osdSetFoldersFont
property font_menus : text = "" page "Fonts" label "Menus" store OsdSetup text
property font_titles : text = "" page "Fonts" label "Title bars" store OsdSetup text
property font_terminal : text = "" page "Fonts" label "Terminal (Objectspace Terminal; e.g. 11.Monospace; empty: 11.Monospace)" store OsdSetup text
# (0.4.1) Objectspace Terminal first and the default, as OS/2's command window;
# "system default": xdg-terminal-exec, else the first installed (0.4.0's
# "automatic" and "xdg-terminal-exec" mean it too)
property terminal : choice "Objectspace Terminal,system default,ptyxis,gnome-terminal,kgx,konsole,xfce4-terminal,alacritty,kitty,foot,wezterm,xterm" = "Objectspace Terminal" page "Programs" label "Terminal for text-mode programs" store OsdSetup text
property terminal_command : text = "" page "Programs" label "Or this command (the program goes after it)" store OsdSetup text
