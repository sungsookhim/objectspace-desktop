# A volume (v0.2-design 5), known by its file system's UUID: opening it
# mounts it if needed and opens its top folder; its menu mounts,
# unmounts, ejects, powers off, unlocks and locks.
class WPDrive : WPAbstract
version 1.0
include "wps_drive_hook.h"
data {
    char *uuid;
}
override wpUnInitData
override wpSaveState
override wpRestoreProperties
override wpModifyPopupMenu
method wpQueryDriveInfo(string which) -> string
method wpQueryDevice() -> string
method wpQueryFsType() -> string
method wpQuerySize() -> string
method wpQueryFree() -> string
method wpQueryMount() -> string
property device : info page Drive label Device get wpQueryDevice first
property fstype : info page Drive label "File system" get wpQueryFsType first
property size : info page Drive label Size get wpQuerySize first
property free : info page Drive label Free get wpQueryFree first
property mount : info page Drive label "Mounted at" get wpQueryMount first
property uuid : info page Drive label UUID get wpQueryUUID first
method wpQueryUUID() -> string
method wpSetUUID(string uuid) -> bool
classoverride wpclsQueryTitle
