# The root of all WPS objects.
class WPObject
version 1.1
include "wps_state.h"
data {
    char *title;        /* NULL: the class decides (see wpQueryTitle) */
    char *icon;         /* its own icon, a PNG (WPS keeps a copy); NULL: its kind's */
    char id[37];        /* object ID; empty until assigned (lazily, by the service) */
    uint32_t dirty;     /* state changed since the last save */
    uint64_t changes;   /* in-memory change counter, for optimistic client writes */
    bool is_template;
    wps_state *state;   /* stored properties, per class (see wps_state.h) */
}
override wpInitData
override wpUnInitData
method wpQueryTitle() -> string
method wpSetTitle(string title) -> bool
# The object's own icon: the path of a PNG, or "" for its kind's again.
method wpQueryIcon() -> string
method wpSetIcon(string path) -> bool
method wpQueryHandle() -> string
# Menus and settings pages are data, built as text by each class and
# parsed by the service into structures for clients (design: Menus and
# settings pages as data):
#   menu item:      id<TAB>label[<TAB>parent-id[<TAB>flags]]   flags: disabled,checked
#   settings page:  page<TAB>title
#   settings field: field<TAB>key<TAB>type<TAB>label<TAB>value<TAB>setter[<TAB>choices]
#                   type: text, number, checkbox, choice, icon (a PNG's path); setter: a method name
method wpModifyPopupMenu(string menu) -> string
method wpMenuItemSelected(int item) -> bool
method wpSaveDeferred() -> void
method wpObjectChanged() -> void
# Persistence. The service reads and writes storage on workers; these run on
# the loop thread and only move values between fields and the state bag.
method wpAddSettingsPages(string pages) -> string
# Events (object-properties-design.md 2.4) and what is done on them: the
# on:EVENT properties (its own, its type's, its class's, ...; none: the
# Sound object's sound for it). Kinds, several with "|": sound:FILE,
# run:COMMAND (with WPS_OBJECT, WPS_PATH, WPS_EVENT, WPS_CLASS), call:METHOD
# ARGS, set:SETUP, none (silence).
event object.open, object.create, object.trash, object.delete
# Its General and Icon pages.
property title : text page General label Title get wpQueryTitle set wpSetTitle
property template : checkbox page General label Template get wpQueryTemplate set wpSetTemplate
property icon : icon page Icon label Icon get wpQueryIcon set wpSetIcon
# Its open icon (0.4 step 3; OS/2's animation icon): shown while it is open
# (a folder's window, a program running); "": the theme's, or the in-use look.
property icon_open : icon page Icon label Open
property on:object.open : text page Actions label "When opened" last
property on:object.create : text page Actions label "When made" last
property on:object.trash : text page Actions label "When put in the Trash Can" last
property on:object.delete : text page Actions label "When deleted" last
# Declared properties (object-properties-design.md 2.1; their `property`
# lines in each class's .wpi): a value as text (NULL: no such property),
# set from text (false: refused), and all of them as "name\tvalue" lines.
method wpQueryProperty(string name) -> string
method wpSetProperty(string name, string value) -> bool
method wpListProperties() -> string
# Templates: a template object is copied, settings and all, to make new ones.
method wpQueryTemplate() -> bool
method wpSetTemplate(bool on) -> bool
method wpSaveState() -> bool
method wpRestoreProperties() -> void
classmethod wpclsQueryTitle() -> string
