# Test class, version 1.1: the installed version. Adds data and a method
# at the end, which must not break plug-ins built against 1.0.
class TBase
version 1.1
data {
    int a;
    int b;
    char pad[40];
}
override osdInitData
method tGetA() -> int
method tSetA(int v) -> void
method tDescribe() -> string
method tGetB() -> int
