# systemd unit for the WPS change helper (optional; see docs/object-core-design.md).
[Unit]
Description=WPS filesystem change helper
Documentation=https://github.com/sungsookhim/wps-linux

[Service]
ExecStart=/usr/libexec/wps-watchd -s /run/wps-watchd.sock
# Only what fanotify filesystem marks and handle lookups need.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectHome=read-only
ProtectSystem=strict
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
