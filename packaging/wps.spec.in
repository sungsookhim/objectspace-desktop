# The WPS RPM (v0.2-design 11.3). Made into build/wps.spec by `make dist`
# (@VERSION@ from VERSION, a "-" as "~"; @RELEASE@ 1 for a release, the
# commit count for a development build).

Name:           wps
Version:        @VERSION@
Release:        @RELEASE@%{?dist}
Summary:        Desktop built on the object model of the OS/2 Workplace Shell
License:        MIT
URL:            https://github.com/sungsookhim/wps-linux
Source0:        %{name}-%{version}.tar.gz

ExclusiveArch:  x86_64 aarch64

BuildRequires:  gcc
BuildRequires:  make
BuildRequires:  git-core
BuildRequires:  python3
BuildRequires:  systemd-rpm-macros
BuildRequires:  glib2
BuildRequires:  pam-devel
# (the unit tests read the MIME database)
BuildRequires:  shared-mime-info
BuildRequires:  pkgconfig(sqlite3)
BuildRequires:  pkgconfig(libsystemd)
BuildRequires:  pkgconfig(cairo)
BuildRequires:  pkgconfig(harfbuzz)
BuildRequires:  pkgconfig(freetype2)
BuildRequires:  pkgconfig(fontconfig)
BuildRequires:  pkgconfig(wayland-client)
BuildRequires:  pkgconfig(wayland-cursor)
BuildRequires:  pkgconfig(wayland-server)
BuildRequires:  pkgconfig(wayland-protocols)
BuildRequires:  pkgconfig(wayland-scanner)
BuildRequires:  pkgconfig(xkbcommon)
BuildRequires:  pkgconfig(wlroots-0.20)
BuildRequires:  pkgconfig(pixman-1)
BuildRequires:  pkgconfig(libdrm)
BuildRequires:  pkgconfig(xcb)
BuildRequires:  pkgconfig(libpipewire-0.3)
BuildRequires:  pkgconfig(sndfile)
# the icon themes (make icons: tools/icons, and wpsctl icon pack)
BuildRequires:  python3-pillow
BuildRequires:  pkgconfig(zlib)
# icon themes' SVGs (0.4 step 2)
BuildRequires:  pkgconfig(librsvg-2.0)
# WPS Terminal (0.4.1)
BuildRequires:  pkgconfig(vterm)

# The session: X11 programs, drives, settings shared with GNOME, icons
# made from SVGs, file types and the icon theme; input methods when installed.
Requires:       xorg-x11-server-Xwayland
Requires:       udisks2
Requires:       gsettings-desktop-schemas
Requires:       glycin-thumbnailer
Requires:       dbus
Requires:       shared-mime-info
Requires:       adwaita-icon-theme
Recommends:     ibus
Recommends:     %{name}-gnome-shell-extension = %{version}-%{release}
%{?systemd_requires}

%description
A desktop for Linux built on the object model of the OS/2 Workplace Shell:
every file, folder and abstract item is a persistent object of a class
that can be extended, with shadows, templates and settings notebooks.

It runs as its own session from the login screen (wps-compositor, its own
Wayland compositor: the desktop, folder windows, the WarpCenter with its tray,
notifications and Messages, the Trash Can, Drives, Programs, Startup) or
inside GNOME with the wps-gnome-shell-extension package.

%package devel
Summary:        The plug-in SDK for WPS: headers, class interfaces and a sample
Requires:       %{name} = %{version}-%{release}
Requires:       python3
Requires:       gcc
Requires:       make

%description devel
What a WPS plug-in is built with: the headers it includes, the built-in
classes' interfaces (.wpi), wpoc (the class compiler), and a sample plug-in
(%{_datadir}/wps/sdk/sample). wpsctl plugin new NAME makes a skeleton;
see %{_datadir}/wps/sdk/README.md.

%package gnome-shell-extension
Summary:        Runs the WPS desktop inside GNOME
BuildArch:      noarch
Requires:       %{name} = %{version}-%{release}
Requires:       gnome-shell

%description gnome-shell-extension
A GNOME Shell extension that runs the WPS desktop (wps-shell) as GNOME's
desktop: below all windows, on every workspace, out of Alt+Tab and the
overview. Turn it on with GNOME Extensions (or gnome-extensions enable
wps@wps-linux).

%prep
%autosetup -n %{name}-%{version}

%build
# (no sanitizers in a package; the distribution's flags after ours)
%make_build SAN= OPTFLAGS="%{optflags}" PREFIX=%{_prefix} LIBDIR=%{_libdir} \
    USERUNITDIR=%{_userunitdir} SYSTEMUNITDIR=%{_unitdir} session

%install
%make_install SAN= OPTFLAGS="%{optflags}" PREFIX=%{_prefix} LIBDIR=%{_libdir} \
    USERUNITDIR=%{_userunitdir} SYSTEMUNITDIR=%{_unitdir} MANDIR=%{_mandir} INCLUDEDIR=%{_includedir}
# wpsd starts with every graphical session (systemctl --global, by preset)
install -d %{buildroot}%{_userpresetdir}
echo "enable wpsd.service" > %{buildroot}%{_userpresetdir}/80-wps.preset

%check
%make_build SAN= unit-test

%post
%systemd_user_post wpsd.service
%systemd_post wps-watchd.service

%preun
%systemd_user_preun wpsd.service
%systemd_preun wps-watchd.service

%postun
%systemd_postun_with_restart wps-watchd.service

%files
%license LICENSE
%doc README.md docs/roadmap.md
%{_bindir}/wpsctl
%{_bindir}/wps-shell
%{_bindir}/wps-terminal
%{_bindir}/wps-session
%dir %{_libexecdir}/wps
%{_libexecdir}/wps/wpsd
%{_libexecdir}/wps/wps-watchd
%{_libexecdir}/wps/wps-plughost
%{_libexecdir}/wps/wps-compositor
%dir %{_libdir}/wps
%dir %{_libdir}/wps/plugins
%{_userunitdir}/wpsd.service
%{_userpresetdir}/80-wps.preset
%{_unitdir}/wps-watchd.service
%{_datadir}/wayland-sessions/wps.desktop
%{_datadir}/wps
%exclude %{_datadir}/wps/sdk
%config(noreplace) %{_sysconfdir}/pam.d/wps-lock
%{_mandir}/man1/wpsctl.1*
%{_mandir}/man1/wps-shell.1*
%{_mandir}/man1/wps-session.1*

%files devel
%license LICENSE
%{_includedir}/wps
%{_datadir}/wps/sdk

%files gnome-shell-extension
%license LICENSE
%{_datadir}/gnome-shell/extensions/wps@wps-linux

%changelog
* @DATE@ Sungsoo Khim <calmssea@gmail.com> - @VERSION@-@RELEASE@
- Built from the repository (see the release notes on GitHub)
