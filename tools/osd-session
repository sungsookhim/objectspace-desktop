#!/bin/sh
# The WPS session (G5 step 4): what "WPS" on the login screen starts
# (/usr/share/wayland-sessions/objectspace.desktop, from tools/install-session.sh).
#
# osd-compositor on the screens and input devices, WPS's desktop in it on
# the Desktop folder, osdd (the user service). GNOME's settings are shared
# (gui-design.md: Settings shared with GNOME): the keyboard layout and the
# pointer's look come from them, and other programs follow the WPS
# scheme's light or dark choice through the desktop portal, whose
# Settings answer from the same GNOME settings (the desktop keeps them
# in step with the WPS scheme).
#
# Its log: ~/.local/state/objectspace/session.log (the last session's; the one
# before is session.log.old).
# Where the programs are: installed (make install fills these in), or this
# source tree's build/ (run from the tree); OSD_LIBEXEC and OSD_BINDIR
# override both (tests of an install in a scratch root).
LIBEXEC=${OSD_LIBEXEC:-@LIBEXECDIR@}
BINDIR=${OSD_BINDIR:-@BINDIR@}
case $LIBEXEC in @*)
    REPO=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
    LIBEXEC=$REPO/build
    BINDIR=$REPO/build ;;
esac
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/objectspace
mkdir -p "$STATE"
[ -f "$STATE/session.log" ] && mv "$STATE/session.log" "$STATE/session.log.old"
exec 2>> "$STATE/session.log"
echo "osd-session: $(date)" >&2

# Settings of your own for the session, one NAME=value a line (e.g.
# WLR_RENDERER=pixman to draw in software): ~/.config/objectspace/session.env
ENVFILE=${XDG_CONFIG_HOME:-$HOME/.config}/objectspace/session.env
if [ -f "$ENVFILE" ]; then
    while IFS= read -r line; do
        case "$line" in ''|\#*) continue ;; *=*) export "$line"; echo "osd-session: $line" >&2 ;; esac
    done < "$ENVFILE"
fi

export XDG_CURRENT_DESKTOP=WPS XDG_SESSION_DESKTOP=wps XDG_SESSION_TYPE=wayland OSD_SESSION=1
export MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM="wayland;xcb" SDL_VIDEODRIVER=wayland _JAVA_AWT_WM_NONREPARENTING=1

# The keyboard layout: GNOME's first input source, and its options.
src=$(gsettings get org.gnome.desktop.input-sources sources 2>/dev/null | grep -o "('xkb', '[^']*')" | head -1 | sed "s/('xkb', '\(.*\)')/\1/")
if [ -n "$src" ]; then
    export XKB_DEFAULT_LAYOUT=${src%%+*}
    case "$src" in *+*) export XKB_DEFAULT_VARIANT=${src#*+} ;; esac
fi
opts=$(gsettings get org.gnome.desktop.input-sources xkb-options 2>/dev/null | tr -d "[]' " )
[ -n "$opts" ] && [ "$opts" != "@as" ] && export XKB_DEFAULT_OPTIONS=$opts
# Input methods (GNOME's IBus sources: Hangul, Anthy, ...): IBus's own
# service for sessions other than GNOME, with XIM for X11 programs; GTK,
# Qt and X11 programs reach it through their IBus modules (WPS's own
# fields do not yet: they need the compositor's input-method support).
# The compositor's Super+Space sets IBus's engine (compositor/keymap.c).
IM_VARS=
if command -v ibus-daemon >/dev/null && [ -f /usr/lib/systemd/user/org.freedesktop.IBus.session.generic.service ]; then
    # (its panel - the input method's menu and candidate lists, e.g. Hanja -
    # is a package of its own, ibus-panel, which GNOME does not need: without
    # it IBus will not start unless told to go without one)
    panel=; [ -x /usr/libexec/ibus-ui-gtk3 ] || panel=' --panel disable'
    export GTK_IM_MODULE=ibus QT_IM_MODULE=ibus XMODIFIERS=@im=ibus IBUS_DAEMON_ARGS="--xim$panel"
    IM_VARS="GTK_IM_MODULE QT_IM_MODULE XMODIFIERS IBUS_DAEMON_ARGS"
fi
# The pointer's look.
theme=$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d "'")
size=$(gsettings get org.gnome.desktop.interface cursor-size 2>/dev/null)
[ -n "$theme" ] && export XCURSOR_THEME=$theme
[ -n "$size" ] && export XCURSOR_SIZE=$size

# Idle: screens off after GNOME's "Blank screen" time (0: never), then the
# lock screen if "Automatic screen lock" is on, after its delay
# (Settings > Privacy > Screen lock). Read when the session starts.
idle=$(gsettings get org.gnome.desktop.session idle-delay 2>/dev/null | sed 's/^uint32 //')
lock=$(gsettings get org.gnome.desktop.screensaver lock-enabled 2>/dev/null)
lockd=$(gsettings get org.gnome.desktop.screensaver lock-delay 2>/dev/null | sed 's/^uint32 //')
case $idle in ''|*[!0-9]*) ;; *) export OSD_IDLE_DELAY=$idle ;; esac
[ "$lock" = false ] && export OSD_LOCK_ENABLED=0
case $lockd in ''|*[!0-9]*) ;; *) export OSD_LOCK_DELAY=$lockd ;; esac

# The desktop portal: GNOME's GTK backend (its Settings read GNOME's
# settings), for a desktop named WPS.
PORTALS=${XDG_CONFIG_HOME:-$HOME/.config}/xdg-desktop-portal
mkdir -p "$PORTALS"
[ -f "$PORTALS/wps-portals.conf" ] || printf '[preferred]\ndefault=gtk;\norg.freedesktop.impl.portal.Secret=oo7-portal;gnome-keyring;\n' > "$PORTALS/wps-portals.conf"

# VirtualBox's guest additions: its shared clipboard, started as usual
# (VBoxClient-all), takes this session for X11 under XWayland and reaches
# no clipboard here; in its Wayland mode (data control) it works. So in
# this session (only) it starts that way, by two autostart entries of the
# user's: the system's own, kept from WPS (NotShowIn), and WPS's. Neither
# is written over once there (the user's own edits stay).
AUTOSTART=${XDG_CONFIG_HOME:-$HOME/.config}/autostart
if [ -c /dev/vboxguest ] && [ -f /etc/xdg/autostart/vboxclient.desktop ] && command -v VBoxClient >/dev/null; then
    mkdir -p "$AUTOSTART"
    [ -e "$AUTOSTART/vboxclient.desktop" ] || {
        grep -v '^NotShowIn=' /etc/xdg/autostart/vboxclient.desktop
        echo 'NotShowIn=WPS;'
    } > "$AUTOSTART/vboxclient.desktop"
    [ -e "$AUTOSTART/wps-vboxclient.desktop" ] || printf '%s\n' '[Desktop Entry]' 'Type=Application' \
        'Name=VirtualBox shared clipboard (WPS)' \
        'Comment=VirtualBox guest services, the clipboard in its Wayland mode' \
        'Exec=sh -c "VBoxClient --clipboard --session-type wayland; VBoxClient --checkhostversion"' \
        'OnlyShowIn=WPS;' > "$AUTOSTART/wps-vboxclient.desktop"
fi

# osdd: the user service (tools/install-extension.sh installs it), or
# started here if it is not installed.
if ! systemctl --user start osdd.service 2>/dev/null; then
    "$BINDIR/osdctl" ping >/dev/null 2>&1 || { "$LIBEXEC/osdd" 2>> "$STATE/osdd.log" & }
fi

DESK=$(xdg-user-dir DESKTOP 2>/dev/null)
[ -d "$DESK" ] || DESK=$HOME/Desktop
mkdir -p "$DESK"

# systemd's graphical-session.target is what the desktop portal (and
# other session services) wait for: osd-session.target brings it up while
# the session runs (as gnome-session's targets do).
UNITS=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
WATCH=osd-session-watch-$$.service
mkdir -p "$UNITS"
# DefaultDependencies=no: a target is otherwise ordered after what it
# wants, and the autostart programs come after graphical-session.target,
# which comes after this one: a cycle systemd breaks by dropping them.
# It is bound to a watcher (osd-session-watch-PID.service, a name of this
# session's own), a user service that ends when this script does: when
# the compositor ends, however the session ends (killed at log out before
# this script's last lines), the target stops, and graphical-session.target
# with it. Left active, it kept GNOME from starting at the next login
# ("A graphical session is already running!").
printf '%s\n' '[Unit]' 'Description=The WPS session (objectspace-desktop)' \
    "BindsTo=$WATCH" "After=$WATCH" \
    'BindsTo=graphical-session.target' 'Before=graphical-session.target' \
    'Wants=graphical-session-pre.target' 'After=graphical-session-pre.target' \
    'Wants=xdg-desktop-autostart.target' ${IM_VARS:+'Wants=org.freedesktop.IBus.session.generic.service'} \
    'DefaultDependencies=no' 'Conflicts=shutdown.target' 'Before=shutdown.target' > "$UNITS/osd-session.target"
systemctl --user daemon-reload 2>/dev/null
# (one left from a session that ended badly: away before this one starts)
systemctl --user stop osd-session.target 2>/dev/null
# The watcher: the compositor itself stays in the login session (logind
# gives it the screens and input devices by it), so systemd follows this
# script instead, from outside. When the script ends (however: at log out
# the session's processes are killed), the watcher ends the session for
# systemd: graphical-session.target stops only when nothing wants it, and
# services started in the session (the portal) still do, so it is stopped
# outright, as GNOME's session does at its end; else GNOME will not start
# at the next login ("A graphical session is already running!").
END="systemctl --user stop osd-session.target graphical-session.target; \
systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP $IM_VARS"
systemd-run --user --quiet --collect --unit="$WATCH" -- \
    sh -c "while kill -0 $$ 2>/dev/null; do sleep 1; done; $END" 2>/dev/null

# Once the compositor is up: services started by D-Bus or systemd get its
# display; the session's target starts (the portal follows); GDM is told
# the session is up (it ends its login screen then, not after a time out).
READY="dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP $IM_VARS; \
systemctl --user start osd-session.target; \
gdbus call --system --dest org.gnome.DisplayManager --object-path /org/gnome/DisplayManager/Manager \
    --method org.gnome.DisplayManager.Manager.RegisterSession >/dev/null 2>&1; \
systemctl --user restart xdg-desktop-portal.service 2>/dev/null"
"$LIBEXEC/osd-compositor" -d "'$BINDIR/osd-shell' --desktop '$DESK'" -s "$READY"
status=$?
echo "osd-session: the compositor ended ($status)" >&2
# What this session started and set for systemd goes with it (the
# watcher does it too, if this script is killed before).
sh -c "$END" 2>/dev/null
exit $status
