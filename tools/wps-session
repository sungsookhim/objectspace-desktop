#!/bin/sh
# The WPS session (G5 step 4): what "WPS" on the login screen starts
# (/usr/share/wayland-sessions/wps.desktop, from tools/install-session.sh).
#
# wps-compositor on the screens and input devices, WPS's desktop in it on
# the Desktop folder, wpsd (the user service). GNOME's settings are shared
# (gui-design.md: Settings shared with GNOME): the keyboard layout and the
# pointer's look come from them, and other programs follow the WPS
# scheme's light or dark choice through the desktop portal, whose
# Settings answer from the same GNOME settings (the desktop keeps them
# in step with the WPS scheme).
#
# Its log: ~/.local/state/wps/session.log (the last session's; the one
# before is session.log.old).
REPO=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/wps
mkdir -p "$STATE"
[ -f "$STATE/session.log" ] && mv "$STATE/session.log" "$STATE/session.log.old"
exec 2>> "$STATE/session.log"
echo "wps-session: $(date)" >&2

# Settings of your own for the session, one NAME=value a line (e.g.
# WLR_RENDERER=pixman to draw in software): ~/.config/wps/session.env
ENVFILE=${XDG_CONFIG_HOME:-$HOME/.config}/wps/session.env
if [ -f "$ENVFILE" ]; then
    while IFS= read -r line; do
        case "$line" in ''|\#*) continue ;; *=*) export "$line"; echo "wps-session: $line" >&2 ;; esac
    done < "$ENVFILE"
fi

export XDG_CURRENT_DESKTOP=WPS XDG_SESSION_DESKTOP=wps XDG_SESSION_TYPE=wayland WPS_SESSION=1
export MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM="wayland;xcb" SDL_VIDEODRIVER=wayland _JAVA_AWT_WM_NONREPARENTING=1

# The keyboard layout: GNOME's first input source, and its options.
src=$(gsettings get org.gnome.desktop.input-sources sources 2>/dev/null | grep -o "('xkb', '[^']*')" | head -1 | sed "s/('xkb', '\(.*\)')/\1/")
if [ -n "$src" ]; then
    export XKB_DEFAULT_LAYOUT=${src%%+*}
    case "$src" in *+*) export XKB_DEFAULT_VARIANT=${src#*+} ;; esac
fi
opts=$(gsettings get org.gnome.desktop.input-sources xkb-options 2>/dev/null | tr -d "[]' " )
[ -n "$opts" ] && [ "$opts" != "@as" ] && export XKB_DEFAULT_OPTIONS=$opts
# The pointer's look.
theme=$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d "'")
size=$(gsettings get org.gnome.desktop.interface cursor-size 2>/dev/null)
[ -n "$theme" ] && export XCURSOR_THEME=$theme
[ -n "$size" ] && export XCURSOR_SIZE=$size

# The desktop portal: GNOME's GTK backend (its Settings read GNOME's
# settings), for a desktop named WPS.
PORTALS=${XDG_CONFIG_HOME:-$HOME/.config}/xdg-desktop-portal
mkdir -p "$PORTALS"
[ -f "$PORTALS/wps-portals.conf" ] || printf '[preferred]\ndefault=gtk;\norg.freedesktop.impl.portal.Secret=oo7-portal;gnome-keyring;\n' > "$PORTALS/wps-portals.conf"

# wpsd: the user service (tools/install-extension.sh installs it), or
# started here if it is not installed.
if ! systemctl --user start wpsd.service 2>/dev/null; then
    "$REPO/build/wpsctl" ping >/dev/null 2>&1 || { "$REPO/build/wpsd" 2>> "$STATE/wpsd.log" & }
fi

DESK=$(xdg-user-dir DESKTOP 2>/dev/null)
[ -d "$DESK" ] || DESK=$HOME/Desktop
mkdir -p "$DESK"

# systemd's graphical-session.target is what the desktop portal (and
# other session services) wait for: wps-session.target brings it up while
# the session runs (as gnome-session's targets do).
UNITS=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
WATCH=wps-session-watch-$$.service
mkdir -p "$UNITS"
# It is bound to a watcher (wps-session-watch-PID.service, a name of this
# session's own), a user service that ends when this script does: when
# the compositor ends, however the session ends (killed at log out before
# this script's last lines), the target stops, and graphical-session.target
# with it. Left active, it kept GNOME from starting at the next login
# ("A graphical session is already running!").
printf '%s\n' '[Unit]' 'Description=The WPS session (wps-linux)' \
    "BindsTo=$WATCH" "After=$WATCH" \
    'BindsTo=graphical-session.target' 'Before=graphical-session.target' \
    'Wants=graphical-session-pre.target' 'After=graphical-session-pre.target' > "$UNITS/wps-session.target"
systemctl --user daemon-reload 2>/dev/null
# (one left from a session that ended badly: away before this one starts)
systemctl --user stop wps-session.target 2>/dev/null
# The watcher: the compositor itself stays in the login session (logind
# gives it the screens and input devices by it), so systemd follows this
# script instead, from outside. When the script ends (however: at log out
# the session's processes are killed), the watcher ends the session for
# systemd: graphical-session.target stops only when nothing wants it, and
# services started in the session (the portal) still do, so it is stopped
# outright, as GNOME's session does at its end; else GNOME will not start
# at the next login ("A graphical session is already running!").
END="systemctl --user stop wps-session.target graphical-session.target; \
systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP"
systemd-run --user --quiet --collect --unit="$WATCH" -- \
    sh -c "while kill -0 $$ 2>/dev/null; do sleep 1; done; $END" 2>/dev/null

# Once the compositor is up: services started by D-Bus or systemd get its
# display; the session's target starts (the portal follows); GDM is told
# the session is up (it ends its login screen then, not after a time out).
READY="dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP; \
systemctl --user start wps-session.target; \
gdbus call --system --dest org.gnome.DisplayManager --object-path /org/gnome/DisplayManager/Manager \
    --method org.gnome.DisplayManager.Manager.RegisterSession >/dev/null 2>&1; \
systemctl --user restart xdg-desktop-portal.service 2>/dev/null"
"$REPO/build/wps-compositor" -d "'$REPO/build/wps-shell' --desktop '$DESK'" -s "$READY"
status=$?
echo "wps-session: the compositor ended ($status)" >&2
# What this session started and set for systemd goes with it (the
# watcher does it too, if this script is killed before).
sh -c "$END" 2>/dev/null
exit $status
